-            if var.starts_with("//") {
-                continue;
-            }
-            let var = normalize_blur(&expand_constants(var, &constants));
-            out.push_str("R ");
-            out.push_str(&var.replace(['\t', '\n'], " "));
-            out.push('\n');
-        }
