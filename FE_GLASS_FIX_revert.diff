+        let same = match (std::fs::read(&src), std::fs::read(&dst)) {
+            (Ok(a), Ok(b)) => a == b,
+            _ => false,
+        };
+        if !same && let Err(e) = std::fs::copy(&src, &dst) {
+            tracing::warn!(%e, "ExplorerBlurMica.dll deploy failed (locked?)");
+        }
