-        out.push_str("<AcrylicBrush");
-        let mut wrote_opacity = false;
-        for (src_name, dst_name) in [
-            ("TintColor", "TintColor"),
-            ("TintOpacity", "TintOpacity"),
-            ("Opacity", "Opacity"),
-        ] {
