-// ------------------------------------------------------------ scoping ----
-fn is_cabinet(hwnd: Hwnd) -> bool {
-    if hwnd.is_null() {
-        return false;
-    }
-    // "CabinetWClass" — 13 UTF-16 units.
-    const EXPECT: [u16; 13] = [67, 97, 98, 105, 110, 101, 116, 87, 67, 108, 97, 115, 115];
-    let mut cls = [0u16; 32];
-    let n = unsafe {
-        win32::GetClassNameW(
-            crate::bindings::HWND(hwnd),
-            windows_core::PWSTR(cls.as_mut_ptr()),
-            32,
-        )
-    };
-    n == 13 && cls[..13] == EXPECT
-}
