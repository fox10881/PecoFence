+                    | (((g * txt_a) >> 8) << 8)
+                    | ((b * txt_a) >> 8);
+            }
+        }
+    }
+    unsafe {
+        let _ = EndBufferedPaint(hpb, windows_core::BOOL(1));
+    }
+    res
