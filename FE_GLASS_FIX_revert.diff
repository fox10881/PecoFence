-                .filter_map(|v| v.as_str())
-                .filter(|s| !s.starts_with("//"))
-                .filter_map(|s| {
-                    let (k, v) = s.split_once('=')?;
-                    Some((k.trim().to_string(), v.trim().to_string()))
-                })
-                .collect()
-        })
-        .unwrap_or_default();
