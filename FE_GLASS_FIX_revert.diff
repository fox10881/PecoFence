+fn parse_rgba(s: &str) -> Option<(u8, u8, u8, u8)> {
+    let hex = s.strip_prefix('#').unwrap_or(s);
+    let v = match hex.len() {
+        8 => u32::from_str_radix(hex, 16).ok()?,
+        6 => u32::from_str_radix(hex, 16).ok()? | 0xFF00_0000,
+        _ => return None,
