+    pat[len as usize..len as usize + suffix.len()].copy_from_slice(suffix);
+    let mut data = FindDataW {
+        attrs: 0,
+        _times: [0; 6],
+        _size: [0; 2],
+        _reserved: [0; 2],
+        name: [0; 260],
+        _alt: [0; 14],
