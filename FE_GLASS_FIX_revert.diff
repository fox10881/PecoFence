-fn tramp<F>(name: &'static str) -> Option<F> {
-    let p = *TRAMPS.lock().unwrap_or_else(|p| p.into_inner()).get(name)?;
-    if p == 0 {
-        return None;
-    }
-    Some(unsafe { core::mem::transmute_copy::<usize, F>(&p) })
-}
